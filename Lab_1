def ubbi_dubbi(word):
    output = []  
    vowels = 'aeiouAEIOU'  

    for letter in word:  # Итерация по каждой букве в слове
        if letter in vowels:  # Если буква гласная
            output.append(f'ub{letter}')  
        else:
            output.append(letter)  
            
    return ''.join(output)  

